# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY=7d

# Payment Gateways
# Stripe (International)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Email (Resend/SendGrid)
EMAIL_FROM=noreply@kawaiora.com
RESEND_API_KEY=re_...

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KawaiOra Artisan Hampers

# Storage (Supabase Storage / Cloudinary / S3)
NEXT_PUBLIC_STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public

# Feature Flags
NEXT_PUBLIC_ENABLE_SAME_DAY_DELIVERY=true
NEXT_PUBLIC_ENABLE_GIFT_CARDS=true
NEXT_PUBLIC_ENABLE_CUSTOM_BUILDER=true